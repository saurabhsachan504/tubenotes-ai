# ===========================================================================
# PRODUCTION .env  ->  DGX par isko  .env  naam se save karo
#
#   cp .env.prod.example .env
#   nano .env            # neeche wale <FILL> bharo
#
# Ye file GitHub par kabhi mat daalo.
# ===========================================================================

ENV=prod
DEBUG=false
APP_NAME=TubeNotes API
APP_BASE_URL=https://tubenotes.ai
UNLIMITED_EMAILS:sachansaurabh59@gmail.com

# --- database --------------------------------------------------------------
# DATABASE_URL docker-compose.prod.yml khud set karta hai (db service ka
# hostname "db" hai). Yahan sirf password chahiye - dono jagah yahi use hota hai.
POSTGRES_PASSWORD=<FILL: openssl rand -hex 24>
# Only for docker-compose.shared-db.prod.yml. These defaults match the current
# /opt/trialguard compose project; change them only if `docker network ls` or
# `docker inspect trialguard-db-1` shows different names.
TRIALGUARD_DOCKER_NETWORK=trialguard_default
SHARED_DB_HOST=trialguard-db-1

# --- secrets ---------------------------------------------------------------
# Dono alag-alag hone chahiye. Banane ke liye:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<FILL>
# DHYAN: ye badalne par har device ka trial ledger reset ho jata hai
# (fingerprint isi se hash hota hai). Ek baar set karo, phir kabhi mat badlo.
DEVICE_HASH_SECRET=<FILL: alag wala>
# /admin routes ke liye. Khali chhodoge to admin endpoints band rahenge.
ADMIN_API_KEY=<FILL>
# Optional admin analytics reset point. This hides older records; it never deletes them.
# ADMIN_REPORTING_START_AT=2026-09-27T09:30:00Z

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- trial policy ----------------------------------------------------------
FREE_TRIAL_LIMIT=5
ENFORCE_DEVICE_TRIAL_LIMIT=true
ENFORCE_MACHINE_TRIAL_LIMIT=true
MACHINE_TRIAL_LIMIT=15
MAX_ACCOUNTS_PER_DEVICE=3
MAX_DEVICES_PER_FREE_USER=2
MAX_DEVICES_PER_PAID_USER=5
REQUIRE_EMAIL_VERIFICATION=false

# --- billing ---------------------------------------------------------------
# Live payment lagne tak "mock" hi rahega, PAR mock ka test endpoint band
# rakhna zaroori hai - warna koi bhi banda apne aap ko free subscription de
# lega. MOCK_BILLING_SECRET khali = wo route exist hi nahi karta.
PAYMENT_PROVIDER=mock
MOCK_BILLING_SECRET=
PLAN_PRICE_CENTS=1000
PLAN_CURRENCY=USD
PLAN_INTERVAL=month
INDIA_PLAN_PRICE_SUBUNITS=29900
INTERNATIONAL_PLAN_PRICE_CENTS=1000
INDIA_LAUNCH_OFFER_ENABLED=true
INDIA_LAUNCH_OFFER_PRICE_SUBUNITS=9900
INTERNATIONAL_LAUNCH_OFFER_ENABLED=false
INTERNATIONAL_LAUNCH_OFFER_PRICE_CENTS=500
INTERNATIONAL_LAUNCH_COUPON_TTL_HOURS=168
INTERNATIONAL_LAUNCH_OFFER_ENDS_AT=2026-10-31T18:29:59Z
PERSONAL_LAUNCH_OFFER_ENABLED=false
PERSONAL_LAUNCH_OFFER_EMAILS=
PERSONAL_LAUNCH_OFFER_PRICE_SUBUNITS=29800
PERSONAL_LAUNCH_COUPON_TTL_HOURS=168
PERSONAL_LAUNCH_OFFER_ENDS_AT=2026-10-31T18:29:59Z
BILLING_SUCCESS_URL=https://tubenotes.ai/billing/success
BILLING_CANCEL_URL=https://tubenotes.ai/billing/cancel
# Primary TubeNotes deployment par khali rakho. Agar purane/secondary domain
# ko live rakhna hai, uske .env mein https://tubenotes.ai set karo.
BILLING_PRIMARY_SITE_URL=

# Razorpay (India se bill karna ho to) - dashboard se lo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_PLAN_ID_INR=
RAZORPAY_PLAN_ID_INR_LAUNCH_OFFER=
RAZORPAY_PLAN_ID_USD=
RAZORPAY_PLAN_ID_USD_LAUNCH_OFFER=
RAZORPAY_PLAN_ID_INR_PERSONAL_OFFER=
RAZORPAY_WEBHOOK_SECRET=
# This must be true only if Cloudflare/Tunnel is the only way to reach origin.
TRUST_CLOUDFLARE_COUNTRY_HEADER=true

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- web app / summarisation (vLLM + Gemma) ---------------------------------
WEB_APP_ENABLED=true

# ONE model serves every language. There is no second model and no router.
# vLLM speaks the OpenAI API, so this is its /v1 base URL.
VLLM_URL=http://gemma4:8000/v1
VLLM_MODEL=gemma4-summarizer
# Blank when vLLM was started without --api-key.
VLLM_API_KEY=
VLLM_TIMEOUT_SECONDS=600
# Cloudflare Access service token, when vLLM sits behind a protected tunnel.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ---- THE CONCURRENCY CONTRACT ---------------------------------------------
# Read this before changing any number below.
#
# VLLM_MAX_CONCURRENCY is PER UVICORN WORKER. What reaches the GPU is
#
#     workers x VLLM_MAX_CONCURRENCY
#
# and that product must equal vLLM's --max-num-seqs. Here: 3 x 10 = 30, and
# vLLM runs --max-num-seqs 30. The app may fill the server, never overfill it.
#
# This is the setting whose absence caused the hang. NOTES_CONCURRENCY only
# ever bounded the chunks of a SINGLE video, so N simultaneous videos put
# N x NOTES_CONCURRENCY generations onto a 4-sequence server; the overflow
# queued inside vLLM, timed out, and the retry loop fed it straight back in.
VLLM_MAX_CONCURRENCY=10
# How long a request waits for a free slot before it is told the server is
# busy. Ends a pile-up; it does not police ordinary queueing. 0 = wait forever.
VLLM_QUEUE_TIMEOUT_SECONDS=300

# Long transcripts are sampled to this budget before summarising. Applies to
# the on-screen SUMMARY only - full notes always read the whole transcript.
TRANSCRIPT_MAX_CHARS=12000

# --- full notes (the PDF) ---------------------------------------------------
# Bigger chunks = fewer round trips for the same transcript.
NOTES_CHUNK_CHARS=6000
NOTES_CHUNK_OVERLAP=400
# 0 = no limit, so a 3-hour video is covered end to end.
NOTES_MAX_CHUNKS=0
NOTES_NUM_PREDICT=4096
# Chunks of ONE video in flight at once. It no longer needs to be conservative:
# VLLM_MAX_CONCURRENCY is the real cap and it is enforced across every request
# rather than inside each one. Set it high and let the gate do the limiting.
NOTES_CONCURRENCY=30
NOTES_CHUNK_RETRIES=3
# Chunks of one translation in flight at once - same reasoning.
TRANSLATE_CONCURRENCY=30

# Blocking work (the yt-dlp transcript fetch, and every database call an
# endpoint makes) runs on this pool. Starlette's default of 40 is exhausted by
# a burst of long videos, and then even /healthz queues behind a download.
THREADPOOL_MAX_THREADS=96

# Ek hi video ka transcript summary ke liye ek baar aur PDF ke liye dobara
# YouTube se aata tha - dono baar server ke IP se. Cache se doosri fetch
# bilkul khatam. 0 = cache band.
TRANSCRIPT_CACHE_TTL_SECONDS=1800
TRANSCRIPT_CACHE_MAX_ENTRIES=200

# ---- sabhi users ke beech share hone wala cache ---------------------------
# Ek video ka summary/notes ek baar banta hai; uske baad har agle user ko DB se
# turant milta hai - na YouTube, na Gemma. Naapa hua: 515 ms.
OUTPUT_CACHE_ENABLED=true
# Itne din tak jise kisi ne nahi khola, wo row cron se hat jayegi.
OUTPUT_CACHE_TTL_DAYS=180
# Itne se chhota jawab cache mat karo - wo aksar fail hua jawab hota hai.
OUTPUT_CACHE_MIN_CHARS=200
# Unlisted/private video kabhi cache nahi hoti, taki kisi ki private video ka
# summary us ajnabi ko na mile jise sirf video ID pata hai. Ye check ek extra
# request leta hai, sirf cache miss par. Check na ho paye to cache nahi karta.
CACHE_ONLY_PUBLIC_VIDEOS=true

# Server ka IP YouTube se block ho jaye to yahan proxy daalna
YOUTUBE_PROXY=

# --- transport / CORS ------------------------------------------------------
# "*" isliye theek hai: hum cookie use nahi karte (allow_credentials=False),
# auth Authorization header se hoti hai. Extension ka origin
# chrome-extension://<id> hota hai jo har install par badal sakta hai, isliye
# use list mein pin karna practical nahi.
ALLOWED_ORIGINS=*
# Comma-separated Chrome extension ids allowed to call this API. Find yours at
# chrome://extensions with Developer mode on. EMPTY means every extension may
# call it, which is the default and was the only behaviour until this was
# actually enforced - the setting existed and nothing read it.
# Only chrome-extension:// origins are checked; the web app is unaffected.
ALLOWED_EXTENSION_IDS=

# Nginx ke peeche hain, isliye asli client IP X-Forwarded-For se lo - warna
# rate limiter ko har request Nginx se aati dikhegi aur sab ek hi bucket mein
# gir jayenge.
TRUST_PROXY_HEADERS=true

RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
SIGNUP_RATE_LIMIT=5
SIGNUP_RATE_WINDOW_SECONDS=3600

# --- email -----------------------------------------------------------------
# "console" matlab mail sirf log mein chhapta hai. Password reset asli mail se
# bhejna ho to smtp kar do aur neeche ke fields bharo.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@tubenotes.ai
SUPPORT_EMAIL=support@tubenotes.ai
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

BCRYPT_ROUNDS=12
