# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------

ENV=dev                       # dev | test | prod
DEBUG=true
APP_NAME=TrialGuard API
APP_BASE_URL=http://localhost:8000

# --- database --------------------------------------------------------------
# dev
DATABASE_URL=sqlite:///./trialguard.db
# prod
# DATABASE_URL=postgresql+psycopg://trialguard:password@db:5432/trialguard

# --- secrets (MUST be changed for production) ------------------------------
SECRET_KEY=change-me-to-a-long-random-string
# Peppers the device fingerprint before it is stored. Changing this later
# resets every device ledger, so set it once and keep it safe.
DEVICE_HASH_SECRET=change-me-to-a-different-long-random-string
ADMIN_API_KEY=
# Email(s) allowed to open /admin. Comma separate multiple admins.
ADMIN_EMAILS=admin@example.com
# Optional: show only admin analytics created at/after this UTC time; records stay safe.
# ADMIN_REPORTING_START_AT=2026-09-27T09:30:00Z

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- trial policy ----------------------------------------------------------
FREE_TRIAL_LIMIT=5
ENFORCE_DEVICE_TRIAL_LIMIT=true
# Coarse hardware-only ledger. Survives "clear extension storage", but has
# lower entropy, so give it a looser cap than FREE_TRIAL_LIMIT.
ENFORCE_MACHINE_TRIAL_LIMIT=true
MACHINE_TRIAL_LIMIT=15
MAX_ACCOUNTS_PER_DEVICE=3
MAX_DEVICES_PER_FREE_USER=2
MAX_DEVICES_PER_PAID_USER=5
REQUIRE_EMAIL_VERIFICATION=false

# --- billing ---------------------------------------------------------------
PAYMENT_PROVIDER=mock         # mock | stripe | razorpay
# Required to enable the fake checkout/webhook used for local testing.
# Leave EMPTY in any deployment that is reachable from the internet.
MOCK_BILLING_SECRET=local-dev-mock-secret
PLAN_PRICE_CENTS=500
PLAN_CURRENCY=USD
PLAN_INTERVAL=month
# India uses INR paise; international uses USD cents.
INDIA_PLAN_PRICE_SUBUNITS=29900
INTERNATIONAL_PLAN_PRICE_CENTS=500
# India-only launch offer: create a separate Razorpay monthly Rs 99 plan.
INDIA_LAUNCH_OFFER_ENABLED=true
INDIA_LAUNCH_OFFER_PRICE_SUBUNITS=9900
BILLING_SUCCESS_URL=https://yourdomain.com/billing/success
BILLING_CANCEL_URL=https://yourdomain.com/billing/cancel

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=              # optional; omit to build the $5/mo price inline
STRIPE_WEBHOOK_SECRET=

# Razorpay (use this if you bill from an Indian entity)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Create two monthly Razorpay Subscription plans. Keep the legacy value only
# while migrating an existing USD-only deployment.
RAZORPAY_PLAN_ID=
RAZORPAY_PLAN_ID_INR=
RAZORPAY_PLAN_ID_INR_LAUNCH_OFFER=
RAZORPAY_PLAN_ID_USD=
RAZORPAY_WEBHOOK_SECRET=
# Enable only when the origin accepts requests exclusively through Cloudflare.
TRUST_CLOUDFLARE_COUNTRY_HEADER=false

# --- web app / summarisation (vLLM + Gemma) ---------------------------------
WEB_APP_ENABLED=true

# ONE model serves every language. There is no second model and no router.
# vLLM speaks the OpenAI API, so this is its /v1 base URL.
VLLM_URL=http://gemma4:8000/v1
VLLM_MODEL=gemma4-summarizer
# Blank when vLLM was started without --api-key.
VLLM_API_KEY=
VLLM_TIMEOUT_SECONDS=600
# Cloudflare Access service token, when vLLM sits behind a protected tunnel.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ---- THE CONCURRENCY CONTRACT ---------------------------------------------
# Read this before changing any number below.
#
# VLLM_MAX_CONCURRENCY is PER UVICORN WORKER. What reaches the GPU is
#
#     workers x VLLM_MAX_CONCURRENCY
#
# and that product must equal vLLM's --max-num-seqs. Here: 3 x 10 = 30, and
# vLLM runs --max-num-seqs 30. The app may fill the server, never overfill it.
#
# This is the setting whose absence caused the hang. NOTES_CONCURRENCY only
# ever bounded the chunks of a SINGLE video, so N simultaneous videos put
# N x NOTES_CONCURRENCY generations onto a 4-sequence server; the overflow
# queued inside vLLM, timed out, and the retry loop fed it straight back in.
VLLM_MAX_CONCURRENCY=10
# How long a request waits for a free slot before it is told the server is
# busy. Ends a pile-up; it does not police ordinary queueing. 0 = wait forever.
VLLM_QUEUE_TIMEOUT_SECONDS=300

# Long transcripts are sampled to this budget before summarising. Applies to
# the on-screen SUMMARY only - full notes always read the whole transcript.
TRANSCRIPT_MAX_CHARS=12000

# --- full notes (the PDF) ---------------------------------------------------
# Bigger chunks = fewer round trips for the same transcript.
NOTES_CHUNK_CHARS=6000
NOTES_CHUNK_OVERLAP=400
# 0 = no limit, so a 3-hour video is covered end to end.
NOTES_MAX_CHUNKS=0
NOTES_NUM_PREDICT=4096
# Chunks of ONE video in flight at once. It no longer needs to be conservative:
# VLLM_MAX_CONCURRENCY is the real cap and it is enforced across every request
# rather than inside each one. Set it high and let the gate do the limiting.
NOTES_CONCURRENCY=30
NOTES_CHUNK_RETRIES=3
# Chunks of one translation in flight at once - same reasoning.
TRANSLATE_CONCURRENCY=30

# Blocking work (the yt-dlp transcript fetch, and every database call an
# endpoint makes) runs on this pool. Starlette's default of 40 is exhausted by
# a burst of long videos, and then even /healthz queues behind a download.
THREADPOOL_MAX_THREADS=96
# Set this if YouTube starts blocking your server's IP (datacenter IPs get
# throttled). Example: http://user:pass@proxy-host:port
YOUTUBE_PROXY=

# --- transport -------------------------------------------------------------
# Lock this down to your extension once you know its id:
# ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
ALLOWED_ORIGINS=*

# Set to true ONLY when the app sits behind a reverse proxy you control that
# overwrites X-Forwarded-For. Otherwise clients can spoof their IP past the
# rate limiter.
TRUST_PROXY_HEADERS=false

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
SIGNUP_RATE_LIMIT=5
SIGNUP_RATE_WINDOW_SECONDS=3600

# --- email -----------------------------------------------------------------
EMAIL_BACKEND=console         # console | smtp
EMAIL_FROM=no-reply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
